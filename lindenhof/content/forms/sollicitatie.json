{
    "title": "Sollicitatie",
    "settings": {
        "submit": "Verstuur je sollicitatie",
        "success": "Bedankt voor je sollicitatie. Het rekruteringsteam antwoordt binnen de week.",
        "redirect": null,
        "notify": [],
        "subject": "Sollicitatie: {first_name} {family_name}",
        "reply_to_field": "email",
        "confirmation": true,
        "confirmation_subject": "We hebben je sollicitatie",
        "confirmation_message": "<p>Bedankt voor je sollicitatie. Het rekruteringsteam leest elke kandidatuur en antwoordt binnen de week.</p>",
        "store": true,
        "honeypot": true,
        "min_seconds": 3,
        "webhook": null,
        "enabled": true
    },
    "fields": [
        {
            "id": "lh004",
            "type": "columns",
            "props": {
                "layout": "1-1",
                "gap": "4",
                "stack": "md"
            },
            "children": [
                {
                    "id": "lh004c0",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh002",
                            "type": "form/text",
                            "props": {
                                "label": "Voornaam",
                                "name": "first_name",
                                "required": true,
                                "autocomplete": "given-name"
                            }
                        }
                    ]
                },
                {
                    "id": "lh004c1",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh003",
                            "type": "form/text",
                            "props": {
                                "label": "Familienaam",
                                "name": "family_name",
                                "required": true,
                                "autocomplete": "family-name"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "lh024",
            "type": "columns",
            "props": {
                "layout": "1-1",
                "gap": "4",
                "stack": "md"
            },
            "children": [
                {
                    "id": "lh024c0",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh022",
                            "type": "form/email",
                            "props": {
                                "label": "E-mail",
                                "name": "email",
                                "required": true,
                                "autocomplete": "email"
                            }
                        }
                    ]
                },
                {
                    "id": "lh024c1",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh023",
                            "type": "form/tel",
                            "props": {
                                "label": "Telefoon",
                                "name": "phone",
                                "required": true,
                                "autocomplete": "tel"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "lh025",
            "type": "form/file",
            "props": {
                "label": "Je cv",
                "name": "cv",
                "required": true,
                "accept": "documents",
                "max_mb": 10,
                "help": "Een pdf of Word-document, tot 10 MB."
            }
        },
        {
            "id": "lh026",
            "type": "form/textarea",
            "props": {
                "label": "Waarom deze job?",
                "name": "motivation",
                "required": true,
                "rows": 6,
                "max": 3000
            }
        },
        {
            "id": "lh001",
            "type": "form/consent",
            "props": {
                "name": "consent",
                "text": "Ik ga ermee akkoord dat AZ Lindenhof deze gegevens gebruikt om mij te antwoorden, zoals de <a href=\"/privacy\">privacyverklaring</a> zegt."
            }
        }
    ]
}
