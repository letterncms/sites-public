{
    "title": "Contact",
    "settings": {
        "submit": "Verstuur je bericht",
        "success": "Bedankt. We antwoorden binnen drie werkdagen. Is het dringend, bel ons dan.",
        "redirect": null,
        "notify": [],
        "subject": "Bericht: {topic}",
        "reply_to_field": "email",
        "confirmation": true,
        "confirmation_subject": "We hebben je bericht",
        "confirmation_message": "<p>Bedankt voor je bericht. We antwoorden binnen drie werkdagen.</p>",
        "store": true,
        "honeypot": true,
        "min_seconds": 3,
        "webhook": null,
        "enabled": true
    },
    "fields": [
        {
            "id": "lh029",
            "type": "columns",
            "props": {
                "layout": "1-1",
                "gap": "4",
                "stack": "md"
            },
            "children": [
                {
                    "id": "lh029c0",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh027",
                            "type": "form/text",
                            "props": {
                                "label": "Naam",
                                "name": "name",
                                "required": true,
                                "autocomplete": "name"
                            }
                        }
                    ]
                },
                {
                    "id": "lh029c1",
                    "type": "column",
                    "children": [
                        {
                            "id": "lh028",
                            "type": "form/email",
                            "props": {
                                "label": "E-mail",
                                "name": "email",
                                "required": true,
                                "autocomplete": "email"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "lh030",
            "type": "form/tel",
            "props": {
                "label": "Telefoon",
                "name": "phone",
                "autocomplete": "tel",
                "help": "Alleen als je wilt dat we je terugbellen."
            }
        },
        {
            "id": "lh031",
            "type": "form/select",
            "props": {
                "label": "Waarover gaat het?",
                "name": "topic",
                "required": true,
                "placeholder": "Kies een onderwerp",
                "options": "question|Een vraag\npraise|Een compliment of bedankje\ncomplaint|Een klacht\naccessibility|De toegankelijkheid van deze website\nrecords|Mijn medisch dossier\napplication|Een spontane sollicitatie\nother|Iets anders"
            }
        },
        {
            "id": "lh032",
            "type": "form/textarea",
            "props": {
                "label": "Je bericht",
                "name": "message",
                "required": true,
                "rows": 6,
                "max": 5000,
                "help": "Stuur geen uitgebreide medische gegevens via dit formulier."
            }
        },
        {
            "id": "lh001",
            "type": "form/consent",
            "props": {
                "name": "consent",
                "text": "Ik ga ermee akkoord dat AZ Lindenhof deze gegevens gebruikt om mij te antwoorden, zoals de <a href=\"/privacy\">privacyverklaring</a> zegt."
            }
        }
    ]
}
