{
    "title": "Appointment request",
    "settings": {
        "submit": "Send request",
        "success": "Thank you. We have your request and will call you within two working days to agree a time.",
        "redirect": null,
        "notify": [],
        "subject": "Appointment request: {specialty}",
        "reply_to_field": "email",
        "confirmation": true,
        "confirmation_subject": "We have your appointment request",
        "confirmation_message": "<p>Thank you for your request. We will call you within two working days to agree a time. In an emergency, always call 112.</p>",
        "store": true,
        "honeypot": true,
        "min_seconds": 3,
        "webhook": null,
        "enabled": true
    },
    "fields": [
        {
            "id": "hv002",
            "type": "form/radio",
            "props": {
                "label": "Who is the appointment for?",
                "name": "for",
                "required": true,
                "look": "chips",
                "options": "me|Me\nother|Someone I care for"
            }
        },
        {
            "id": "hv005",
            "type": "columns",
            "props": {
                "layout": "1-1",
                "gap": "4",
                "stack": "md"
            },
            "children": [
                {
                    "id": "hv005c0",
                    "type": "column",
                    "children": [
                        {
                            "id": "hv003",
                            "type": "form/text",
                            "props": {
                                "label": "First name",
                                "name": "first_name",
                                "required": true,
                                "autocomplete": "given-name"
                            }
                        }
                    ]
                },
                {
                    "id": "hv005c1",
                    "type": "column",
                    "children": [
                        {
                            "id": "hv004",
                            "type": "form/text",
                            "props": {
                                "label": "Family name",
                                "name": "family_name",
                                "required": true,
                                "autocomplete": "family-name"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "hv006",
            "type": "form/text",
            "props": {
                "label": "Name of the patient",
                "name": "patient",
                "required": true,
                "help": "We need the name of the person the appointment is for.",
                "show_if": {
                    "field": "for",
                    "op": "equals",
                    "value": "other"
                }
            }
        },
        {
            "id": "hv009",
            "type": "columns",
            "props": {
                "layout": "1-1",
                "gap": "4",
                "stack": "md"
            },
            "children": [
                {
                    "id": "hv009c0",
                    "type": "column",
                    "children": [
                        {
                            "id": "hv007",
                            "type": "form/tel",
                            "props": {
                                "label": "Phone",
                                "name": "phone",
                                "required": true,
                                "help": "We call you on this number to agree a time."
                            }
                        }
                    ]
                },
                {
                    "id": "hv009c1",
                    "type": "column",
                    "children": [
                        {
                            "id": "hv008",
                            "type": "form/email",
                            "props": {
                                "label": "Email",
                                "name": "email",
                                "required": true
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "hv010",
            "type": "form/select",
            "props": {
                "label": "Specialty",
                "name": "specialty",
                "required": true,
                "options": "Not sure\nCardiology\nGynaecology\nGeriatric medicine\nLaboratory medicine\nMaternity and birth\nMedical imaging\nNeurology\nOncology\nOrthopaedics\nPaediatrics\nPhysiotherapy and rehabilitation",
                "placeholder": "Choose a specialty"
            }
        },
        {
            "id": "hv011",
            "type": "form/radio",
            "props": {
                "label": "Do you have a referral letter?",
                "name": "referral",
                "required": true,
                "look": "chips",
                "options": "yes|Yes\nno|No\nunsure|I don’t know"
            }
        },
        {
            "id": "hv012",
            "type": "form/file",
            "props": {
                "label": "Referral letter",
                "name": "referral_letter",
                "accept": "documents",
                "max_mb": 10,
                "help": "A PDF or a photo of the letter, up to 10 MB. You can also bring it on the day.",
                "show_if": {
                    "field": "referral",
                    "op": "equals",
                    "value": "yes"
                }
            }
        },
        {
            "id": "hv013",
            "type": "form/checkboxes",
            "props": {
                "label": "When suits you best?",
                "name": "when",
                "look": "chips",
                "options": "morning|Mornings\nafternoon|Afternoons\nany|Any time"
            }
        },
        {
            "id": "hv014",
            "type": "form/textarea",
            "props": {
                "label": "What would you like to see us about?",
                "name": "reason",
                "rows": 4,
                "max": 1000,
                "help": "A few words are enough. Please don’t send detailed medical information here."
            }
        },
        {
            "id": "hv015",
            "type": "form/checkboxes",
            "props": {
                "label": "Do you need any support during your visit?",
                "name": "support",
                "options": "wheelchair|A wheelchair or help with walking\ninterpreter|An interpreter\nsign|A sign language interpreter\nloop|A hearing loop\ncompanion|Someone to come with me from the entrance"
            }
        },
        {
            "id": "hv001",
            "type": "form/consent",
            "props": {
                "name": "consent",
                "text": "I agree that Halvard Hospital uses these details to answer me, as the <a href=\"/privacy\">privacy statement</a> says."
            }
        }
    ]
}
